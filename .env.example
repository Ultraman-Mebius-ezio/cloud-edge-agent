# ── 云端大模型（DeepSeek）──────────────────────────────
# 去 https://platform.deepseek.com 申请，Key 只放本地 .env，不要提交
DEEPSEEK_API_KEY=
CLOUD_MODEL=deepseek/deepseek-chat

# ── 本地小模型（Ollama）────────────────────────────────
OLLAMA_BASE=http://localhost:11434
LOCAL_MODEL=ollama_chat/nanbeige4.2-3b-32k
LOCAL_NUM_CTX=16384
# 注意 16384 是本机实测的拐点，不是随手写的：RTX 5060 Laptop(8GB) 上
# 4096/8192/12288/16384 都是 ~71 tok/s，24576 掉到 21，32768 掉到 10.7（KV cache 挤爆显存）。
# 计划书原定 32768 —— 本机实测该值纯亏 6.6 倍速度且用不满，故下调，超长上下文靠 runner 截断兜底。
# thinking 开关。实测 ON/OFF 输出 token 差 15 倍，必须作为受控变量固定
LOCAL_THINK=0

# ── 云端不可用时的降级 ─────────────────────────────────
# 1 = 云端调用自动落到本地模型（tier 如实记 local，绝不虚报 cloud_tokens）
# 0 = 严格模式，云端调用直接返回 error（指标口径最纯净）
CLOUD_FALLBACK_LOCAL=1

# ── 规划链档位（local | cloud）──────────────────────────
# 决定 dot 流水线里「分解」与「汇聚」由谁执行。
# 实测 dot 的云端 token 有 90%+ 花在这两笔上，下沉到本地即可把 dot 的云端消耗
# 压到纯云端之下（短问答 0.45×、长上下文 0.79×）——但准确率与延迟的代价见
# docs/实验报告_v4_规划链下沉.md，当前 3B 上这笔交易不成立。
# 默认 cloud：本机 3B 的组合推理能力不足以承担汇聚。
PLANNER_TIER=cloud
AGGREGATOR_TIER=cloud

# ── 子任务执行器的计算器工具 ────────────────────────────
# 1 = 挂计算器（本地求值，不产生云端 token）
# 0 = 不挂，模型自己心算（对照用）
#
# 实测动机：模型会在完全正确的分解链上把「25 − 22」算成 1，换更大的模型也一样。
# 挂上后本地规划配置的准确率 73.3% → 93.3%，而云端 token 只涨 34%。
# **代价**：带 tools 时 Ollama 失去前缀缓存，每次调用要全量预填（prompt 约 400 token
# 时约 2 秒），本地延迟涨一个数量级。详见 docs/实验报告_v5_计算器工具.md。
TOOLS_ENABLED=1

# ── 采样（可复现性）────────────────────────────────────
TEMPERATURE=0.0
SEED=42
MAX_TOKENS=2048
